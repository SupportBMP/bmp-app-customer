<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the process starts, until Flutter draws its first frame
         (the animated SplashOverlay). Same colour in light and dark mode. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/splash_background</item>
        <item name="android:navigationBarColor">@color/splash_background</item>
    </style>
    <!-- Window background behind the Flutter UI once it is running (the app is light-only). -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
